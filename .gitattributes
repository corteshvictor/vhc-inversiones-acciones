# The distributable ZIP is built from these files byte for byte, so a checkout
# that rewrites line endings produces a different package. Windows defaults to
# core.autocrlf=true, which is exactly that. Pin the working tree to LF so the
# skill anyone builds is the skill everyone else builds.
* text=auto eol=lf

# Binaries must never be touched by that normalization. The brand assets carry
# byte sequences that look like line endings, and a heuristic that guesses
# wrong corrupts the image inside the package.
*.png    binary
*.webp   binary
*.xlsx   binary
*.zip    binary
*.ico    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.pdf    binary
